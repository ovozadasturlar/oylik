<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Oylik.Mobile.ViewModels"
             xmlns:s="clr-namespace:Oylik.Mobile.Logic;assembly=Oylik.Mobile.Logic"
             x:Class="Oylik.Mobile.Pages.SyncPage"
             x:DataType="vm:SyncViewModel"
             Title="{x:Static s:Strings.TabSync}">
    <ScrollView>
        <VerticalStackLayout Padding="16,20" Spacing="14">
            <Label Text="{x:Static s:Strings.SyncTitle}" Style="{StaticResource H1}" />

            <Border IsVisible="{Binding ClockWrong}" BackgroundColor="{StaticResource WarnBg}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="14,10">
                <Label Text="{x:Static s:Strings.ClockWrong}" TextColor="{StaticResource WarnText}" FontAttributes="Bold" />
            </Border>

            <Border Style="{StaticResource Card}">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
                    <Label Text="{x:Static s:Strings.SyncPending}" Style="{StaticResource MutedText}" FontSize="15" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding PendingCount}" FontSize="26" FontAttributes="Bold" />

                    <Label Grid.Row="1" Text="{x:Static s:Strings.SyncLastOk}" Style="{StaticResource MutedText}" FontSize="15" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding LastOk}" FontAttributes="Bold" />

                    <Label Grid.Row="2" Text="{x:Static s:Strings.SyncServer}" Style="{StaticResource MutedText}" FontSize="15" />
                    <VerticalStackLayout Grid.Row="2" Grid.Column="1" HorizontalOptions="End">
                        <Label Text="{Binding ServerState}" TextColor="{Binding ServerStateColor}" FontAttributes="Bold" HorizontalTextAlignment="End" />
                        <Label Text="{Binding ServerText}" Style="{StaticResource MutedText}" HorizontalTextAlignment="End" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border IsVisible="{Binding HasError}" BackgroundColor="{StaticResource RedBg}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="14,10">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{x:Static s:Strings.SyncError}" TextColor="{StaticResource RedText}" FontAttributes="Bold" />
                    <Label Text="{Binding Error}" TextColor="{StaticResource RedText}" />
                    <Label Text="{Binding NextTry}" TextColor="{StaticResource RedText}" FontSize="13" />
                </VerticalStackLayout>
            </Border>

            <Border IsVisible="{Binding HasFailed}" BackgroundColor="{StaticResource WarnBg}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="14,10">
                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{x:Static s:Strings.SyncFailed}" TextColor="{StaticResource WarnText}" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="{Binding FailedCount}" TextColor="{StaticResource WarnText}" FontAttributes="Bold" />
                    </Grid>
                    <Label Text="{Binding FailedError}" TextColor="{StaticResource WarnText}" FontSize="13" />
                    <Label Text="{x:Static s:Strings.SyncFailedHint}" TextColor="{StaticResource WarnText}" FontSize="13" />
                </VerticalStackLayout>
            </Border>

            <Button Text="{x:Static s:Strings.SyncNow}" Command="{Binding SyncNowCommand}" Style="{StaticResource PrimaryButton}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Primary}" />

            <Label Text="{x:Static s:Strings.SyncOfflineSafe}" Style="{StaticResource MutedText}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
