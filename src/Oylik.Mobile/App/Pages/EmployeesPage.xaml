<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Oylik.Mobile.ViewModels"
             xmlns:r="clr-namespace:Oylik.Mobile.Logic.Rules;assembly=Oylik.Mobile.Logic"
             xmlns:s="clr-namespace:Oylik.Mobile.Logic;assembly=Oylik.Mobile.Logic"
             x:Class="Oylik.Mobile.Pages.EmployeesPage"
             x:DataType="vm:EmployeesViewModel"
             Title="{x:Static s:Strings.TabEmployees}">
    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Sarlavha + holat + qidirish -->
        <VerticalStackLayout Grid.Row="0" BackgroundColor="{StaticResource Surface}" Padding="16,20,16,12" Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{x:Static s:Strings.TabEmployees}" Style="{StaticResource H1}" VerticalOptions="Center" />
                <Border Grid.Column="1" BackgroundColor="{Binding PillBg}" StrokeThickness="0" StrokeShape="RoundRectangle 999"
                        Padding="10,5" VerticalOptions="Center">
                    <Label Text="{Binding PillText}" TextColor="{Binding PillColor}" FontSize="13" />
                </Border>
            </Grid>
            <Border BackgroundColor="{StaticResource Bg}" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="52" Padding="14,0">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Image Source="ic_search.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                    <Entry Grid.Column="1" Text="{Binding SearchText}" Placeholder="{x:Static s:Strings.Search}"
                           ClearButtonVisibility="WhileEditing" VerticalOptions="Center" ReturnType="Search" />
                </Grid>
            </Border>
        </VerticalStackLayout>
        <BoxView Grid.Row="0" HeightRequest="1" Color="{StaticResource Line}" VerticalOptions="End" />

        <!-- Telefon soati noto'g'ri -->
        <Border Grid.Row="1" IsVisible="{Binding ClockWrong}" BackgroundColor="{StaticResource WarnBg}" StrokeThickness="0" Padding="16,10">
            <Label Text="{x:Static s:Strings.ClockWrong}" TextColor="{StaticResource WarnText}" FontAttributes="Bold" />
        </Border>

        <ActivityIndicator Grid.Row="2" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="{StaticResource Primary}"
                           VerticalOptions="Start" Margin="0,32,0,0" />

        <CollectionView Grid.Row="2" ItemsSource="{Binding Items}" BackgroundColor="{StaticResource Surface}" SelectionMode="None"
                        IsVisible="{Binding IsLoading, Converter={StaticResource Not}}" AutomationId="EmployeeList">
            <CollectionView.EmptyView>
                <Label Text="{Binding EmptyText}"
                       Style="{StaticResource MutedText}" FontSize="15" Margin="16,24" HorizontalTextAlignment="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="r:EmployeeRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="16,10" MinimumHeightRequest="76">
                        <VerticalStackLayout VerticalOptions="Center" Spacing="3">
                            <Label Text="{Binding Name}" FontSize="17" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding StatusText}" TextColor="{StaticResource Muted}" FontSize="14">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsInside}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource GreenText}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>
                        <!-- Buyruq parametri — qator obyektining o'zi (xodim Id shundan olinadi). -->
                        <Button Grid.Column="1" Text="{Binding ButtonText}" BackgroundColor="{StaticResource InBtn}"
                                TextColor="White" FontSize="16" FontAttributes="Bold" CornerRadius="12"
                                WidthRequest="112" HeightRequest="56" VerticalOptions="Center"
                                Command="{Binding TapCommand, Source={RelativeSource AncestorType={x:Type vm:EmployeesViewModel}}, x:DataType=vm:EmployeesViewModel}"
                                CommandParameter="{Binding .}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsInside}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource OutBtn}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <BoxView Grid.ColumnSpan="2" HeightRequest="1" Color="{StaticResource LineSoft}" VerticalOptions="End" Margin="-16,0,-16,-10" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Snackbar: "Ism — keldi 08:02 [BEKOR]" 60 s -->
        <Border Grid.Row="2" IsVisible="{Binding HasSnack}" VerticalOptions="End" Margin="12,0,12,16"
                BackgroundColor="{StaticResource Ink}" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                Padding="16,0,8,0" MinimumHeightRequest="56">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.25" Radius="16" Offset="0,6" />
            </Border.Shadow>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Text="{Binding SnackText}" AutomationId="SnackText" TextColor="White" FontSize="15" VerticalOptions="Center" Margin="0,12" />
                <Button Grid.Column="1" Text="{x:Static s:Strings.Undo}" IsVisible="{Binding SnackCanUndo}" Command="{Binding UndoCommand}"
                        BackgroundColor="Transparent" TextColor="#8CB8FF" FontSize="15" FontAttributes="Bold"
                        HeightRequest="48" Padding="12,0" VerticalOptions="Center" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
