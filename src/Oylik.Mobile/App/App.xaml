<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:Oylik.Mobile.Pages"
             x:Class="Oylik.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Dizayn ranglari (MobilePair / MobileEmployees / MobileToday) -->
            <Color x:Key="Primary">#0057D9</Color>
            <Color x:Key="Bg">#F4F5F7</Color>
            <Color x:Key="Surface">#FFFFFF</Color>
            <Color x:Key="Ink">#1C1F23</Color>
            <Color x:Key="Ink2">#3D434C</Color>
            <Color x:Key="Muted">#5B6270</Color>
            <Color x:Key="Line">#E3E6EA</Color>
            <Color x:Key="LineSoft">#ECEEF1</Color>
            <Color x:Key="InputLine">#C9CED6</Color>
            <Color x:Key="InBtn">#1B7A3A</Color>
            <Color x:Key="OutBtn">#B54B00</Color>
            <Color x:Key="GreenText">#145C2B</Color>
            <Color x:Key="GreenBg">#E3F4E8</Color>
            <Color x:Key="GreenDot">#1E7B3A</Color>
            <Color x:Key="GrayBg">#EEF0F3</Color>
            <Color x:Key="RedText">#8F1D22</Color>
            <Color x:Key="RedBg">#FDECEC</Color>
            <Color x:Key="WarnBg">#FFF1E0</Color>
            <Color x:Key="WarnText">#8A3A00</Color>

            <pages:NotConverter x:Key="Not" />

            <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
                <Setter Property="BackgroundColor" Value="{StaticResource Bg}" />
                <Setter Property="Shell.NavBarIsVisible" Value="False" />
            </Style>
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource Ink}" />
                <Setter Property="FontSize" Value="15" />
            </Style>
            <Style x:Key="H1" TargetType="Label">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource Ink}" />
            </Style>
            <Style x:Key="FieldLabel" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource Ink2}" />
            </Style>
            <Style x:Key="MutedText" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{StaticResource Muted}" />
            </Style>
            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="{StaticResource Ink}" />
                <Setter Property="PlaceholderColor" Value="#8A909A" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>
            <Style x:Key="FieldBox" TargetType="Border">
                <Setter Property="Stroke" Value="{StaticResource InputLine}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
                <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
                <Setter Property="HeightRequest" Value="56" />
                <Setter Property="Padding" Value="12,0" />
            </Style>
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="HeightRequest" Value="60" />
            </Style>
            <Style x:Key="OutlineButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
                <Setter Property="TextColor" Value="{StaticResource Ink}" />
                <Setter Property="BorderColor" Value="{StaticResource Ink}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="HeightRequest" Value="56" />
            </Style>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 14" />
                <Setter Property="Padding" Value="16" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
