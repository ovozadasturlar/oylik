<v:DialogWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:vm="using:Oylik.Desktop.ViewModels"
                xmlns:v="using:Oylik.Desktop.Views"
                xmlns:r="using:Oylik.Desktop.Resources"
                x:Class="Oylik.Desktop.Views.NewEmployeeWindow"
                x:DataType="vm:NewEmployeeViewModel"
                Title="{Binding Title}"
                Width="440" SizeToContent="Height" CanResize="False"
                WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="24" Spacing="14">
    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" />
    <StackPanel Spacing="4">
      <TextBlock Text="{r:T FieldName}" Classes="muted" FontWeight="SemiBold" />
      <TextBox x:Name="NameBox" Text="{Binding FullName}" Watermark="Олим ака (тест)" />
    </StackPanel>
    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
      <StackPanel Spacing="4">
        <TextBlock Text="{r:T FieldSalary}" Classes="muted" FontWeight="SemiBold" />
        <TextBox Text="{Binding SalaryText}" Watermark="6" TextAlignment="Right" />
        <TextBlock Text="{Binding SalaryPreview}" Classes="muted" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="4">
        <TextBlock Text="{r:T FieldDaily}" Classes="muted" FontWeight="SemiBold" />
        <TextBox Text="{Binding DailyText}" TextAlignment="Right" />
        <TextBlock Text="{Binding DailyPreview}" Classes="muted" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource NegativeBrush}"
               IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="{r:T Cancel}" Command="{Binding CancelCommand}" />
      <Button Content="{r:T Add}" Command="{Binding AddCommand}" IsDefault="True"
              Classes="Primary" Theme="{DynamicResource SolidButton}" />
    </StackPanel>
  </StackPanel>
</v:DialogWindow>
