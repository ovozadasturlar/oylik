<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>Oylik</AssemblyName>
    <RootNamespace>Oylik.Desktop</RootNamespace>
    <Version>0.1.0</Version>
    <ApplicationIcon>Assets\oylik.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- dotnet publish -c Release -r win-x64 -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <PackageReference Include="Semi.Avalonia" Version="11.3.22" />
    <PackageReference Include="Semi.Avalonia.DataGrid" Version="11.3.13" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- 5.11: PDF shrifti (Noto Sans + zaxira: Symbols 2, Math, Emoji — SIL OFL, Assets/Fonts/OFL.txt) — QuestPDF'ga Avalonia'siz yuklanadi -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Oylik.Data\Oylik.Data.csproj" />
    <ProjectReference Include="..\Oylik.Contracts\Oylik.Contracts.csproj" />
  </ItemGroup>
</Project>
