<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- TZ 6: telefon(lar) ↔ desktop voqealar va xodimlar ro'yxati. Pul ma'lumoti YO'Q (Oylik.Core'ga bog'lanmaydi). -->
  <PropertyGroup>
    <Version>0.2.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- Prod — PostgreSQL (migratsiyalar shu uchun); SQLite — testlar va lokal sinov (Oylik:Database=sqlite). -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Oylik.Contracts\Oylik.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Oylik.Server.Tests" />
  </ItemGroup>
</Project>
