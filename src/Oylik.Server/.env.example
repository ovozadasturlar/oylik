# Nusxa oling: .env — va qiymatlarni to'ldiring. docker compose shu fayldan o'qiydi. Maxfiy — tarqatmang, repoga qo'ymang.
OYLIK_REGISTRATION_KEY=

# Compose ichidagi PostgreSQL (db servisi) paroli — server ham shu bilan ulanadi. Uzun tasodifiy qiymat yozing.
OYLIK_DB_PASSWORD=

# Ixtiyoriy: host porti va konteyner nomi (default 5000 / oylik-server).
# OYLIK_PORT=5000
# OYLIK_CONTAINER_NAME=oylik-server

# Faqat docker-compose.external-pg.yml (mavjud tashqi PostgreSQL) ishlatilsa:
# OYLIK_DB_CONNECTION=Host=host.docker.internal;Port=5432;Database=oylik;Username=oylik;Password=
